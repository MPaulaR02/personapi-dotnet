@model personapi_dotnet.Models.ViewModels.TelefonoViewModel

@{
    ViewData["Title"] = "Telefono Details";
}

<div class="container mt-4">
    <h1>Telefono Details</h1>

    <div>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Num)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Num)</dd>
            
            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Oper)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Oper)</dd>
            
            <dt class="col-sm-2">Persona</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.PersonaNombre)</dd>
        </dl>
    </div>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Num" class="btn btn-warning">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>

