@model personapi_dotnet.Models.ViewModels.TelefonoViewModel

@{
    ViewData["Title"] = "Create Telefono";
}

<div class="container mt-4">
    <h1>Create Telefono</h1>

    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group mb-3">
                    <label asp-for="Num" class="control-label"></label>
                    <input asp-for="Num" class="form-control" />
                    <span asp-validation-for="Num" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Oper" class="control-label"></label>
                    <input asp-for="Oper" class="form-control" />
                    <span asp-validation-for="Oper" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Duenio" class="control-label">Persona</label>
                    <select asp-for="Duenio" class="form-control" asp-items="ViewBag.Duenio">
                        <option value="">-- Select Persona --</option>
                    </select>
                    <span asp-validation-for="Duenio" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input type="submit" value="Create" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

