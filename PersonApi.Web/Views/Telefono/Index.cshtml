@model IEnumerable<personapi_dotnet.Models.ViewModels.TelefonoViewModel>

@{
    ViewData["Title"] = "Telefonos";
}

<div class="container mt-4">
    <h1>Telefonos</h1>

    <p>
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    </p>
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Num)</th>
                <th>@Html.DisplayNameFor(model => model.Oper)</th>
                <th>@Html.DisplayNameFor(model => model.PersonaNombre)</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Num)</td>
                    <td>@Html.DisplayFor(modelItem => item.Oper)</td>
                    <td>@Html.DisplayFor(modelItem => item.PersonaNombre)</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Num" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.Num" class="btn btn-sm btn-info">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.Num" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

