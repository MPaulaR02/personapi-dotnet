@model personapi_dotnet.Models.ViewModels.PersonaViewModel

@{
    ViewData["Title"] = "Persona Details";
}

<div class="container mt-4">
    <h1>Persona Details</h1>

    <div>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Cc)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Cc)</dd>
            
            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Nombre)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Nombre)</dd>
            
            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Apellido)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Apellido)</dd>
            
            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Genero)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Genero)</dd>
            
            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Edad)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Edad)</dd>
        </dl>

        @if (Model.Telefonos != null && Model.Telefonos.Any())
        {
            <h3>Telefonos</h3>
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Number</th>
                        <th>Operator</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var telefono in Model.Telefonos)
                    {
                        <tr>
                            <td>@telefono.Num</td>
                            <td>@telefono.Oper</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (Model.Estudios != null && Model.Estudios.Any())
        {
            <h3>Estudios</h3>
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>University</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var estudio in Model.Estudios)
                    {
                        <tr>
                            <td>@estudio.Univer</td>
                            <td>@estudio.Fecha?.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Cc" class="btn btn-warning">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>

